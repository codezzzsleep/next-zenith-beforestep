{
  "schema": "beforestep-lux3d-demo/v1",
  "objective": "Actual photo to Lux3D 3D output to observation check to physics rehearsal to independent action",
  "groups": [
    {
      "id": "core",
      "chapter": "先见一步 · 照片变成3D",
      "base_duration_s": 11,
      "parts": [
        {
          "id": "core-robot",
          "kind": "video",
          "base_duration_s": 4,
          "source": "evidence/production-v6/shots/s01-open-v2.mp4",
          "span": 6
        },
        {
          "id": "core-pair",
          "kind": "pair",
          "base_duration_s": 7,
          "source": "evidence/production-v6/shots/r02-glb-A.mp4",
          "span": 8
        }
      ],
      "sentences": [
        {
          "id": "core-01",
          "text": "机器人拍一张石头照片，交给 Lux3D，拿回一整块石头的三维模型。"
        },
        {
          "id": "core-02",
          "text": "先见一步，让机器人据此判断看不见的背面。"
        }
      ]
    },
    {
      "id": "question",
      "chapter": "为什么需要完整形状",
      "base_duration_s": 8,
      "parts": [
        {
          "id": "question-rgb",
          "kind": "video",
          "base_duration_s": 8,
          "source": "evidence/production-v6/shots/s02-eye-v2.mp4",
          "span": 3
        }
      ],
      "sentences": [
        {
          "id": "question-01",
          "text": "相机只拍到石头朝向自己的一面，背面藏在遮挡和黑影里。"
        }
      ]
    },
    {
      "id": "proof",
      "chapter": "一张照片 → Lux3D → 三维模型",
      "base_duration_s": 12,
      "parts": [
        {
          "id": "proof-pair",
          "kind": "pair",
          "base_duration_s": 12,
          "source": "evidence/production-v6/shots/r02-glb-A.mp4",
          "span": 8
        }
      ],
      "sentences": [
        {
          "id": "proof-01",
          "text": "Lux3D 把这张照片，变成可以转到背面看的三维模型。"
        },
        {
          "id": "proof-02",
          "text": "画面中的照片和模型，来自同一个真实任务。"
        }
      ]
    },
    {
      "id": "viewer",
      "chapter": "官方 Aholo Viewer · 真实模型",
      "base_duration_s": 14,
      "parts": [
        {
          "id": "viewer-ui",
          "kind": "video",
          "base_duration_s": 4,
          "source": "evidence/production-v6/shots/r02-glb-A.mp4",
          "span": 4,
          "crop": [
            365,
            100,
            1180,
            610
          ]
        },
        {
          "id": "viewer-close",
          "kind": "viewer",
          "base_duration_s": 10,
          "source": "evidence/production-v6/shots/r02-glb-A.mp4",
          "span": 8
        }
      ],
      "sentences": [
        {
          "id": "viewer-01",
          "text": "用官方 Aholo Viewer，在网页里旋转，直接检查真实返回的形状。"
        },
        {
          "id": "viewer-02",
          "text": "后续对高石盲区的判断，都建立在这个三维模型上。"
        }
      ]
    },
    {
      "id": "check",
      "chapter": "第一道判断 · 模型与照片对得上吗",
      "base_duration_s": 14,
      "parts": [
        {
          "id": "check-model",
          "kind": "viewer",
          "base_duration_s": 6,
          "source": "evidence/production-v6/shots/r03-glb-B.mp4",
          "span": 8
        },
        {
          "id": "check-plot",
          "kind": "image",
          "base_duration_s": 8,
          "source": "evidence/production-v6/figures/r1-self-check.png"
        }
      ],
      "sentences": [
        {
          "id": "check-01",
          "text": "机器人不会直接相信生成结果。先把模型与相机看到的正面核对，对不上的丢掉。"
        },
        {
          "id": "check-02",
          "text": "这块石头返回五份模型，三份被拒绝，只有两份通过。"
        }
      ]
    },
    {
      "id": "worlds",
      "chapter": "第二道判断 · 每份模型里先走一遍",
      "base_duration_s": 18,
      "parts": [
        {
          "id": "world-main",
          "kind": "video",
          "base_duration_s": 12,
          "source": "evidence/production-v6/shots/s05-world-1-v2.mp4",
          "span": 8.0,
          "requested_source_span_s": 12
        },
        {
          "id": "world-grid",
          "kind": "video",
          "base_duration_s": 6,
          "source": "evidence/production-v6/shots/s05-world-grid.mp4",
          "span": 6
        }
      ],
      "sentences": [
        {
          "id": "worlds-01",
          "text": "同一块石头生成多份候选，每份模型都是一种可能的背面。"
        },
        {
          "id": "worlds-02",
          "text": "把通过检查的模型放进虚拟世界，让机器人先把整条路走完。"
        },
        {
          "id": "worlds-03",
          "text": "这一场有十二个世界，全部预演安全，才允许出发。"
        }
      ]
    },
    {
      "id": "action",
      "chapter": "模型改变行动 · 再走真实路线",
      "base_duration_s": 19,
      "parts": [
        {
          "id": "action-route",
          "kind": "video",
          "base_duration_s": 19,
          "source": "evidence/production-v6/shots/s03-imagination-v2.mp4",
          "span": 19
        }
      ],
      "sentences": [
        {
          "id": "action-01",
          "text": "现在，机器人开始按模型判断出的路线，绕过高石头。"
        },
        {
          "id": "action-02",
          "text": "这是原始运行记录：只看一眼，一百十二点八四秒，到达终点。"
        }
      ]
    },
    {
      "id": "comparison",
      "chapter": "同一条路 · 三种判断的原结果",
      "base_duration_s": 14,
      "parts": [
        {
          "id": "compare",
          "kind": "comparison",
          "base_duration_s": 14,
          "source": "evidence/lux3d-demo/sources/comparison.mkv",
          "span": 28
        }
      ],
      "sentences": [
        {
          "id": "comparison-01",
          "text": "同一条路上，把未知当作没有的车撞了，把未知都当危险的车停了。"
        },
        {
          "id": "comparison-02",
          "text": "Lux3D 的模型让这次盲区判断，有了可以检验的依据。"
        }
      ]
    },
    {
      "id": "boundary",
      "chapter": "模型是可以检验的假设",
      "base_duration_s": 14,
      "parts": [
        {
          "id": "back-error",
          "kind": "video",
          "base_duration_s": 5.333333333333333,
          "source": "evidence/production-v6/shots/r01-reveal.mp4",
          "span": 10,
          "start": 1,
          "crop": [
            380,
            455,
            500,
            440
          ]
        },
        {
          "id": "safe-stop",
          "kind": "video",
          "base_duration_s": 8.666666666666668,
          "source": "evidence/production-v6/shots/s09-F3002-A-stop-v2.mp4",
          "span": 14
        }
      ],
      "sentences": [
        {
          "id": "boundary-01",
          "text": "但正面通过核对，背面仍可能被想短。"
        },
        {
          "id": "boundary-02",
          "text": "在另一个场景，候选模型全部被拒绝，机器人选择停车。"
        }
      ]
    },
    {
      "id": "iteration",
      "chapter": "输入、模型与迭代都保留",
      "base_duration_s": 9,
      "parts": [
        {
          "id": "versions-early",
          "kind": "image",
          "base_duration_s": 4.5,
          "source": "evidence/production-v6/figures/six-version-assets.png",
          "crop": [
            20,
            135,
            1400,
            450
          ]
        },
        {
          "id": "versions-later",
          "kind": "image",
          "base_duration_s": 4.5,
          "source": "evidence/production-v6/figures/six-version-assets.png",
          "crop": [
            20,
            600,
            1400,
            450
          ]
        }
      ],
      "sentences": [
        {
          "id": "iteration-01",
          "text": "不同版本的输入照片、真实模型和拒绝结果，都保存在仓库里，评审可以逐一核对。"
        }
      ]
    },
    {
      "id": "records",
      "chapter": "491 个真实任务 · 每次都有记录",
      "base_duration_s": 14,
      "parts": [
        {
          "id": "records-pair",
          "kind": "pair",
          "base_duration_s": 14,
          "source": "evidence/production-v6/shots/r02-glb-A.mp4",
          "span": 8
        }
      ],
      "sentences": [
        {
          "id": "records-01",
          "text": "作品真实创建了四百九十一个 Lux3D 任务，拿回四百六十份模型，三十一次服务端失败。"
        },
        {
          "id": "records-02",
          "text": "每次都保留任务号、输入照片和生成结果。"
        }
      ]
    },
    {
      "id": "ending",
      "chapter": "先见一步 · BeforeStep",
      "base_duration_s": 9,
      "parts": [
        {
          "id": "ending-card",
          "kind": "ending",
          "base_duration_s": 9,
          "source": "evidence/production-v6/shots/r02-glb-A.mp4",
          "span": 8
        }
      ],
      "sentences": [
        {
          "id": "ending-01",
          "text": "从一张照片，到一个三维模型，再到一次有依据的行动。"
        },
        {
          "id": "ending-02",
          "text": "先见一步。"
        }
      ]
    }
  ],
