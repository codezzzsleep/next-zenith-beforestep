          "start_s": 88.2076,
          "end_s": 93.2476,
          "group": "results"
        },
        {
          "id": "results-03",
          "text": "它也撞了二次，二次都留在页面上。",
          "audio": "evidence/production-v6/film/audio/results-03.mp3",
          "audio_sha256": "e275d0d9ef5f09148a81c22b90e59de7848e549d1cb2d28b54ede66f8d6677a0",
